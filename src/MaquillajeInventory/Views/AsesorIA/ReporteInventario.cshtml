@model MakeupInventory.Models.ReporteIAViewModel
@{
    ViewData["Title"] = "Reportes & Recomendaciones de IA - Maquillaje SV";
}

<div class="container-fluid py-3">
    <!-- Encabezado del Módulo de IA (Mockup 5.1.4.g) -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge px-3 py-1 fw-bold text-uppercase small mb-1" style="background-color: #ede9fe; color: var(--color-analitico);">
                <i class="bi bi-cpu-fill me-1"></i> Inteligencia Artificial &amp; Análisis Predictivo
            </span>
            <h1 class="display-6 fw-bold mb-0" style="color: var(--color-principal);">Reportes &amp; Recomendaciones de IA</h1>
            <p class="text-muted small mb-0">Apoyo analítico para la toma de decisiones de compras y prevención de desabastecimiento.</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-printer me-1"></i> Imprimir Informe
            </button>
            <a asp-action="ReporteInventario" class="btn text-white btn-sm fw-bold" style="background-color: var(--color-accion);">
                <i class="bi bi-arrow-clockwise me-1"></i> Actualizar Análisis IA
            </a>
        </div>
    </div>

    <!-- Dictamen Ejecutivo con IA (Mockup 5.1.4.g) -->
    <div class="card card-custom p-4 mb-4 border-start border-4" style="border-left-color: var(--color-analitico) !important;">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h5 class="fw-bold mb-0" style="color: var(--color-principal);">
                <i class="bi bi-chat-square-text-fill me-2" style="color: var(--color-analitico);"></i> Dictamen del Modelo de Inteligencia Artificial
            </h5>
            <span class="small text-muted"><i class="bi bi-clock me-1"></i> @Model.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
        <p class="lead fs-6 text-muted mb-0">
            @Model.ResumenEjecutivo
        </p>
    </div>

    <!-- Métricas del Reporte -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card card-custom p-3">
                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-circle text-white me-3" style="background-color: var(--color-error);">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Productos con Nivel Crítico (&le; 5 unidades):</div>
                        <h3 class="fw-bold mb-0" style="color: var(--color-error);">@Model.TotalProductosStockCritico</h3>
                        <small class="text-muted">Riesgo de pérdida de ventas</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card card-custom p-3">
                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-circle text-white me-3" style="background-color: var(--color-exito);">
                        <i class="bi bi-graph-up-arrow fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Volumen de Ventas Auditadas (Últimos 30 días):</div>
                        <h3 class="fw-bold mb-0" style="color: var(--color-exito);">$@Model.TotalVentasMes.ToString("0.00")</h3>
                        <small class="text-muted">Base de datos histórica activa</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recomendaciones de Abastecimiento (Mockup 5.1.4.g) -->
        <div class="col-lg-6">
            <div class="card card-custom p-4 h-100">
                <h5 class="fw-bold mb-3 border-bottom pb-2" style="color: var(--color-principal);">
                    <i class="bi bi-truck me-2" style="color: var(--color-analitico);"></i> Recomendaciones de Abastecimiento Sugeridas
                </h5>
                <ul class="list-group list-group-flush">
                    @foreach (var rec in Model.RecomendacionesAbastecimiento)
                    {
                        <li class="list-group-item px-0 py-2 d-flex align-items-start">
                            <i class="bi bi-check2-circle me-2 mt-1" style="color: var(--color-exito);"></i>
                            <span class="small">@rec</span>
                        </li>
                    }
                </ul>
                <div class="mt-auto pt-3">
                    <a asp-controller="Inventario" asp-action="Entrada" class="btn btn-sm btn-outline-secondary w-100">
                        <i class="bi bi-plus-circle me-1"></i> Registrar Entrada de Proveedor
                    </a>
                </div>
            </div>
        </div>

        <!-- Alertas de Stock Bajo (Mockup 5.1.4.g) -->
        <div class="col-lg-6">
            <div class="card card-custom p-4 h-100">
                <h5 class="fw-bold mb-3 border-bottom pb-2" style="color: var(--color-error);">
                    <i class="bi bi-shield-exclamation me-2"></i> Alertas Inteligentes de Inventario
                </h5>
                <ul class="list-group list-group-flush">
                    @foreach (var alerta in Model.AlertasStock)
                    {
                        <li class="list-group-item px-0 py-2 d-flex align-items-start">
                            <i class="bi bi-caret-right-fill me-2 mt-1" style="color: var(--color-error);"></i>
                            <span class="small">@alerta</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Tendencias Comerciales Detectadas -->
        <div class="col-12">
            <div class="card card-custom p-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2" style="color: var(--color-principal);">
                    <i class="bi bi-stars me-2" style="color: var(--color-accion);"></i> Tendencias y Oportunidades de Venta
                </h5>
                <div class="row row-cols-1 row-cols-md-3 g-3">
                    @foreach (var op in Model.OportunidadesVenta)
                    {
                        <div class="col">
                            <div class="p-3 border rounded-3 bg-light">
                                <i class="bi bi-lightbulb-fill text-warning me-2"></i>
                                <span class="small fw-semibold">@op</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
