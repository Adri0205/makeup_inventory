@model MakeupInventory.Models.Categoria
@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-custom p-4 border-danger shadow-sm text-center">
                <i class="bi bi-exclamation-octagon text-danger display-4 mb-2"></i>
                <h3 class="fw-bold">¿Deseas eliminar esta categoría?</h3>
                <p class="text-muted small">Ten presente que si la categoría contiene productos asociados, la acción será rechazada por integridad referencial.</p>

                <div class="bg-light p-3 rounded-3 my-3 text-start">
                    <div class="fw-bold">@Model.Nombre</div>
                    <small class="text-muted">@(Model.Descripcion ?? "Sin descripción")</small>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-danger px-4">Eliminar</button>
                        <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
