@model IEnumerable<MakeupInventory.Models.Categoria>
@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="container py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-secondary text-white px-3 py-1 fw-bold text-uppercase small mb-1">
                <i class="bi bi-tags me-1"></i> Clasificación
            </span>
            <h1 class="display-6 fw-bold mb-0">Categorías de Cosméticos</h1>
            <p class="text-muted small mb-0">Estructura y catálogo de rubros para los productos.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-beauty">
                <i class="bi bi-plus-circle me-1"></i> Nueva Categoría
            </a>
        </div>
    </div>

    <div class="card card-custom p-3 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Nombre de la Categoría</th>
                        <th>Descripción</th>
                        <th class="text-end" style="width: 160px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">#@c.Id</span></td>
                            <td class="fw-bold text-dark">@c.Nombre</td>
                            <td class="text-muted small">@(c.Descripcion ?? "Sin descripción")</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
