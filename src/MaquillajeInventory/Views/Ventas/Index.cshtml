@model IEnumerable<MakeupInventory.Models.Venta>
@{
    ViewData["Title"] = "Historial General de Ventas";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 fw-bold text-uppercase small mb-1">
                <i class="bi bi-receipt me-1"></i> Facturación &amp; Ventas
            </span>
            <h1 class="display-6 fw-bold mb-0">Registro y Control de Ventas</h1>
            <p class="text-muted small mb-0">Transacciones completadas mediante el portal web de clientes y mostrador.</p>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <a asp-action="Nueva" class="btn btn-beauty">
                <i class="bi bi-calculator me-1"></i> Nueva Venta en Mostrador (POS)
            </a>
            <button onclick="window.print()" class="btn btn-outline-secondary">
                <i class="bi bi-printer me-1"></i> Imprimir Reporte
            </button>
        </div>
    </div>

    <div class="card card-custom p-3 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 90px;">Orden #</th>
                        <th>Fecha &amp; Hora</th>
                        <th>Cliente / Receptor</th>
                        <th>Canal / Vendedor</th>
                        <th>Método de Pago</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Monto Total</th>
                        <th class="text-center" style="width: 100px;">Comprobante</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">#@v.Id</span></td>
                            <td>
                                <div>@v.Fecha.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">@v.Fecha.ToString("HH:mm:ss")</small>
                            </td>
                            <td>
                                <div class="fw-bold">@(v.ClienteNombre ?? "Cliente en Mostrador")</div>
                                <small class="text-muted">@(v.ClienteEmail ?? "Venta física")</small>
                            </td>
                            <td>
                                @if (v.Usuario != null)
                                {
                                    <span class="badge bg-primary-subtle text-primary border"><i class="bi bi-person-badge me-1"></i>@v.Usuario.Nombre</span>
                                }
                                else
                                {
                                    <span class="badge bg-info-subtle text-info border"><i class="bi bi-globe me-1"></i>Tienda Online</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@v.MetodoPago</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success">@v.Estado</span>
                            </td>
                            <td class="text-end fw-bold text-success fs-6">
                                $@v.Total.ToString("0.00")
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary" title="Ver Comprobante">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
