@model MakeupInventory.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card card-custom p-4 border-danger shadow-sm">
                <div class="text-center mb-3">
                    <i class="bi bi-exclamation-triangle-fill text-danger display-4"></i>
                    <h3 class="fw-bold mt-2">¿Estás seguro de eliminar este producto?</h3>
                    <p class="text-muted small">Esta acción dará de baja el producto del inventario.</p>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4">
                    <h5 class="fw-bold text-dark mb-1">@Model.Nombre</h5>
                    <div class="text-muted small mb-2">Categoría: @(Model.Categoria?.Nombre ?? "Sin asignar")</div>
                    <div class="d-flex justify-content-between">
                        <span>Precio: <strong>$@Model.Precio.ToString("0.00")</strong></span>
                        <span>Stock: <strong>@Model.Stock unidades</strong></span>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash3 me-1"></i> Confirmar Eliminación
                        </button>
                        <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
