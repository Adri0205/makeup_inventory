@model MakeupInventory.Models.Producto

@{
    ViewData["Title"] = "Registro de Producto - Maquillaje SV";
}

<div class="container py-3">
    <!-- Encabezado del Formulario (Mockup 5.1.4.d) -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge px-3 py-1 fw-bold text-uppercase small mb-1" style="background-color: #e0e7ff; color: #4338ca;">
                <i class="bi bi-box-seam me-1"></i> Módulo de Inventario
            </span>
            <h2 class="fw-bold mb-0" style="color: var(--color-principal);">Registro de Producto</h2>
            <p class="text-muted small mb-0">Carga de nueva mercancía al catálogo y control de existencias.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver a Inventario
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card card-custom p-4 shadow-sm">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Bloque 1: Información General (Mockup 5.1.4.d) -->
                    <h5 class="fw-bold pb-2 border-bottom mb-3" style="color: var(--color-principal);">
                        <i class="bi bi-info-circle me-1" style="color: var(--color-accion);"></i> 1. Información General
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre del Producto *</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Labial Mate Indeleble Rouge" required />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Descripcion" class="form-label fw-bold">Descripción / Detalles *</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Fórmula, acabado, duración y detalles cosmetológicos..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="ImagenUrl" class="form-label fw-bold">URL de Fotografía / Imagen (Opcional):</label>
                            <input asp-for="ImagenUrl" class="form-control" placeholder="https://ejemplo.com/foto.jpg" />
                            <span asp-validation-for="ImagenUrl" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Bloque 2: Clasificación y Proveedor (Mockup 5.1.4.d) -->
                    <h5 class="fw-bold pb-2 border-bottom mb-3" style="color: var(--color-principal);">
                        <i class="bi bi-tags me-1" style="color: var(--color-analitico);"></i> 2. Clasificación &amp; Proveedor
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label fw-bold">Categoría *</label>
                            <select asp-for="CategoriaId" class="form-select" asp-items="@(new SelectList(ViewBag.Categorias, "Id", "Nombre"))" required>
                                <option value="">-- Seleccionar Categoría --</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Proveedor" class="form-label fw-bold">Proveedor / Marca *</label>
                            <input asp-for="Proveedor" class="form-control" placeholder="Ej: Maybelline, NYX, L'Oréal" />
                            <span asp-validation-for="Proveedor" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Bloque 3: Precios y Existencias (Mockup 5.1.4.d) -->
                    <h5 class="fw-bold pb-2 border-bottom mb-3" style="color: var(--color-principal);">
                        <i class="bi bi-cash-stack me-1" style="color: var(--color-exito);"></i> 3. Precios &amp; Existencias
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Precio" class="form-label fw-bold">Precio de Venta ($ USD) *</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" required />
                            </div>
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Stock" class="form-label fw-bold">Cantidad Inicial en Stock *</label>
                            <input asp-for="Stock" class="form-control" type="number" min="0" placeholder="0" required />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Acciones: Guardar (Principal) y Cancelar (Secundaria) -->
                    <div class="mt-4 pt-3 border-top d-flex gap-2">
                        <button type="submit" class="btn text-white px-4 fw-bold shadow-sm" style="background-color: var(--color-accion);">
                            <i class="bi bi-save me-1"></i> Guardar Producto
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
