@model MakeupInventory.Models.Producto

@{
    ViewData["Title"] = "Detalle del Producto - " + Model.Nombre;
}

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0"><i class="bi bi-info-circle text-info me-2"></i> Ficha Técnica del Producto</h2>
            <p class="text-muted small mb-0">Información detallada registrada en el sistema de inventario.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i> Editar
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card card-custom p-3 text-center">
                <img src="@(Model.ImagenUrl ?? "https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=400&q=80")" 
                     class="img-fluid rounded shadow-sm mb-3" style="max-height: 280px; width: 100%; object-fit: cover;" alt="@Model.Nombre">
                <span class="badge bg-light text-dark border py-2">
                    Categoría: @(Model.Categoria?.Nombre ?? "Sin Asignar")
                </span>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card card-custom p-4">
                <h3 class="fw-bold mb-3">@Model.Nombre</h3>

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">ID Sistema:</dt>
                    <dd class="col-sm-8 fw-bold">#@Model.Id</dd>

                    <dt class="col-sm-4 text-muted">Proveedor / Marca:</dt>
                    <dd class="col-sm-8">@(Model.Proveedor ?? "No especificado")</dd>

                    <dt class="col-sm-4 text-muted">Precio al Público:</dt>
                    <dd class="col-sm-8 fs-5 fw-bold text-danger">$@Model.Precio.ToString("0.00")</dd>

                    <dt class="col-sm-4 text-muted">Existencias en Almacén:</dt>
                    <dd class="col-sm-8">
                        @if (Model.Stock <= 5)
                        {
                            <span class="badge bg-danger">@Model.Stock unidades (Nivel Crítico)</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@Model.Stock unidades disponibles</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Fecha de Ingreso:</dt>
                    <dd class="col-sm-8">@Model.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4 text-muted">Descripción:</dt>
                    <dd class="col-sm-8 text-muted">@(Model.Descripcion ?? "Sin descripción adicional.")</dd>
                </dl>

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <a asp-controller="Tienda" asp-action="Detalle" asp-route-id="@Model.Id" class="btn btn-outline-beauty btn-sm">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Ver cómo lo ve el cliente
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
